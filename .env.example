# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env asla commit edilmez (.gitignore'da olmalı).

# PostgreSQL + pgvector
POSTGRES_USER=docassistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=docassistant
POSTGRES_PORT=5432

# SeaweedFS (S3 uyumlu dosya saklama)
S3_ACCESS_KEY=docassistant
S3_SECRET_KEY=change-me
S3_BUCKET=documents
S3_PORT=8333
S3_SERVICE_URL=http://localhost:8333
SEAWEEDFS_ADMIN_PORT=23646

# Ollama (geliştirmede Windows'a doğrudan kurulu)
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# .NET connection string (ASP.NET Core ortam değişkeni formatı)
ConnectionStrings__Default=Host=localhost;Port=5432;Database=docassistant;Username=docassistant;Password=change-me
