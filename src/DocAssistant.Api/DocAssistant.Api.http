@DocAssistant.Api_HostAddress = http://localhost:5174

### Health check
GET {{DocAssistant.Api_HostAddress}}/health

### Register a new organization and its first admin (returns a token)
# Running it twice returns 409: the email is already registered.
# @name register
POST {{DocAssistant.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "companyName": "Yıldız Lojistik",
  "email": "ayse@yildiz.com",
  "password": "Gizli123!"
}

### Log in (returns a token)
# @name login
POST {{DocAssistant.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ayse@yildiz.com",
  "password": "Gizli123!"
}

### Current user, with the token from the login request above
GET {{DocAssistant.Api_HostAddress}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### Log out: removes the session cookie a browser got at login (204, also when not signed in)
POST {{DocAssistant.Api_HostAddress}}/auth/logout

### Wrong password: 401
POST {{DocAssistant.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ayse@yildiz.com",
  "password": "wrong-password"
}

### Invalid input: 400 with the field errors
POST {{DocAssistant.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "companyName": "",
  "email": "not-an-email",
  "password": "short"
}

### Upload a document (admins only; returns 202 and the document as Pending)
# Run "Log in" first. The path after "<" is relative to this file.
# @name upload
POST {{DocAssistant.Api_HostAddress}}/documents
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: multipart/form-data; boundary=DocAssistantBoundary

--DocAssistantBoundary
Content-Disposition: form-data; name="file"; filename="ik-yonetmeligi.pdf"
Content-Type: application/pdf

< ../../tests/TestData/ik-yonetmeligi.pdf
--DocAssistantBoundary--

### Status of the document uploaded above
GET {{DocAssistant.Api_HostAddress}}/documents/{{upload.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### Upload without a token: 401
POST {{DocAssistant.Api_HostAddress}}/documents
Content-Type: multipart/form-data; boundary=DocAssistantBoundary

--DocAssistantBoundary
Content-Disposition: form-data; name="file"; filename="ik-yonetmeligi.pdf"
Content-Type: application/pdf

< ../../tests/TestData/ik-yonetmeligi.pdf
--DocAssistantBoundary--

### Ask a question (any member; the answer arrives as a stream of events)
# Run "Log in" first. Needs Ollama with the chat model and at least one processed document.
# @name ask
POST {{DocAssistant.Api_HostAddress}}/chat
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "question": "Yıllık izin kaç gündür?"
}

### My conversations, newest first
# @name conversations
GET {{DocAssistant.Api_HostAddress}}/conversations
Authorization: Bearer {{login.response.body.$.token}}

### The newest conversation with its messages and sources
GET {{DocAssistant.Api_HostAddress}}/conversations/{{conversations.response.body.$[0].id}}
Authorization: Bearer {{login.response.body.$.token}}
