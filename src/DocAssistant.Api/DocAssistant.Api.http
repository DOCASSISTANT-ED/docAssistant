@DocAssistant.Api_HostAddress = http://localhost:5174

### Health check
GET {{DocAssistant.Api_HostAddress}}/health

### Register a new organization and its first admin (returns a token)
# Running it twice returns 409: the email is already registered.
# @name register
POST {{DocAssistant.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "companyName": "Yıldız Lojistik",
  "email": "ayse@yildiz.com",
  "password": "Gizli123!"
}

### Log in (returns a token)
# @name login
POST {{DocAssistant.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ayse@yildiz.com",
  "password": "Gizli123!"
}

### Current user, with the token from the login request above
GET {{DocAssistant.Api_HostAddress}}/auth/me
Authorization: Bearer {{login.response.body.$.token}}

### Log out: removes the session cookie a browser got at login (204, also when not signed in)
POST {{DocAssistant.Api_HostAddress}}/auth/logout

### Wrong password: 401
POST {{DocAssistant.Api_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "ayse@yildiz.com",
  "password": "wrong-password"
}

### Invalid input: 400 with the field errors
POST {{DocAssistant.Api_HostAddress}}/auth/register
Content-Type: application/json

{
  "companyName": "",
  "email": "not-an-email",
  "password": "short"
}

### Upload a document (admins only; returns 202 and the document as Pending)
# Run "Log in" first. The path after "<" is relative to this file.
# @name upload
POST {{DocAssistant.Api_HostAddress}}/documents
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: multipart/form-data; boundary=DocAssistantBoundary

--DocAssistantBoundary
Content-Disposition: form-data; name="file"; filename="ik-yonetmeligi.pdf"
Content-Type: application/pdf

< ../../tests/TestData/ik-yonetmeligi.pdf
--DocAssistantBoundary--

### All documents of the organization, newest first (any member)
GET {{DocAssistant.Api_HostAddress}}/documents
Authorization: Bearer {{login.response.body.$.token}}

### Delete the document uploaded above (admins only; 409 while it is being processed)
DELETE {{DocAssistant.Api_HostAddress}}/documents/{{upload.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### Status of the document uploaded above
GET {{DocAssistant.Api_HostAddress}}/documents/{{upload.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### Upload without a token: 401
POST {{DocAssistant.Api_HostAddress}}/documents
Content-Type: multipart/form-data; boundary=DocAssistantBoundary

--DocAssistantBoundary
Content-Disposition: form-data; name="file"; filename="ik-yonetmeligi.pdf"
Content-Type: application/pdf

< ../../tests/TestData/ik-yonetmeligi.pdf
--DocAssistantBoundary--

### Ask a question (any member; the answer arrives as a stream of events)
# Run "Log in" first. Needs Ollama with the chat model and at least one processed document.
# @name ask
POST {{DocAssistant.Api_HostAddress}}/chat
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "question": "Yıllık izin kaç gündür?"
}

### My conversations, newest first
# @name conversations
GET {{DocAssistant.Api_HostAddress}}/conversations
Authorization: Bearer {{login.response.body.$.token}}

### The newest conversation with its messages and sources
GET {{DocAssistant.Api_HostAddress}}/conversations/{{conversations.response.body.$[0].id}}
Authorization: Bearer {{login.response.body.$.token}}

### Invite someone (admins only; role "Member" or "Admin", Member when left out)
# The token is the key for the link (/davet/<token>); it is shown only in this answer.
# @name invite
POST {{DocAssistant.Api_HostAddress}}/invitations
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "role": "Member"
}

### Invitations that can still be used, newest first (admins only)
GET {{DocAssistant.Api_HostAddress}}/invitations
Authorization: Bearer {{login.response.body.$.token}}

### What the link above is for, without signing in (404 when used, revoked or expired)
GET {{DocAssistant.Api_HostAddress}}/invitations/{{invite.response.body.$.token}}

### Join with the link above (returns a token; 409 when the email is already registered)
POST {{DocAssistant.Api_HostAddress}}/invitations/{{invite.response.body.$.token}}/accept
Content-Type: application/json

{
  "email": "yeni.calisan@example.com",
  "password": "Gizli123!"
}

### Revoke the invitation above (admins only; 404 once it has been used)
DELETE {{DocAssistant.Api_HostAddress}}/invitations/{{invite.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.token}}

### People in the organization, in the order they joined (admins only)
# @name members
GET {{DocAssistant.Api_HostAddress}}/members
Authorization: Bearer {{login.response.body.$.token}}

### Remove the newest person from the organization (admins only; not yourself, not the last admin)
# Their account stays; their token stops working at once.
DELETE {{DocAssistant.Api_HostAddress}}/members/{{members.response.body.$[-1:].userId}}
Authorization: Bearer {{login.response.body.$.token}}
